{
  "Comment": "Top-level state machine for ETL (separate business logic lambda)",
  "StartAt": "TriggerIngestion",
  "States": {
    "TriggerIngestion": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${TriggerIngestionSeparateLambda}",
        "Payload": {
          "ExecutionName.$": "$$.Execution.Name"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "End": true
    }
  }
}