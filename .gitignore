# Python
.venv/
__pycache__/
*.pyc

# IDE
.idea/
.vscode/

# MacOS
.DS_Store

# Local .terraform directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude sensitive variable files
*.tfvars.json
*.auto.tfvars

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Lock file (optionally commit this — remove line to track it)
.terraform.lock.hcl

# other stuff
terraform.tfvars
*.tfplan

trigger.json

# Bootstrap zip generated by lambda_external module — not source code
terraform/modules/lambda_external/bootstrap.zip

# Deployment artifacts copied here by make deploy — not source code
terraform/artifacts/*.zip
